{
  "name": "goplaybot",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#db/*": "./src/db/*",
    "#components/*": "./src/components/*",
    "#contracts/*": "./src/contracts/*"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm logs:rotate && bash -o pipefail -c '{ pnpm migrate:auth && node scripts/run-both.ts dev; } 2>&1 | tee -a data/logs/bot.log'",
    "build": "next build",
    "start": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts start; } >> data/logs/bot.log 2>&1",
    "logs:rotate": "mkdir -p data/logs && find data/logs -maxdepth 1 -name bot.log -size +5M -exec mv {} {}.1 \\;",
    "migrate:auth": "node --env-file=.env scripts/migrate-auth.ts",
    "test": "node --test test/*.test.ts",
    "check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "2.6.2",
    "better-auth": "^1.7.18",
    "discord.js": "^14.28.1",
    "goemoji": "^0.3.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
