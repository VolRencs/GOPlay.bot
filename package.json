{
  "name": "goplaybot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts dev; } 2>&1 | tee -a data/logs/bot.log",
    "build": "next build",
    "start": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts start; } >> data/logs/bot.log 2>&1",
    "logs:rotate": "mkdir -p data/logs && find data/logs -maxdepth 1 -name bot.log -size +5M -exec mv {} {}.1 \\;",
    "migrate:auth": "node --env-file=.env scripts/migrate-auth.ts",
    "test": "node --test test/*.test.ts",
    "check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "2.6.2",
    "better-auth": "^1.7.5",
    "discord.js": "^14.27.0",
    "goemoji": "https://github.com/VolRencs/goemoji/releases/download/v0.2.0/goemoji-0.2.0.tgz",
    "lucide-react": "1.40.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
