{
  "name": "goplaybot",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#db/*": "./src/db/*",
    "#components/*": "./src/components/*",
    "#contracts/*": "./src/contracts/*"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm logs:rotate && bash -o pipefail -c '{ pnpm migrate:auth && node scripts/run-both.ts dev; } 2>&1 | tee -a data/logs/bot.log'",
    "build": "next build",
    "start": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts start; } >> data/logs/bot.log 2>&1",
    "logs:rotate": "mkdir -p data/logs && find data/logs -maxdepth 1 -name bot.log -size +5M -exec mv -f {} {}.1 \\;",
    "migrate:auth": "node --env-file-if-exists=.env scripts/migrate-auth.ts",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.ts",
    "check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-auth": "^1.7.25",
    "discord.js": "^14.28.1",
    "goemoji": "^0.3.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "welcome-render": "https://github.com/VolRencs/welcome-render/releases/download/v0.3.0/welcome-render-0.3.0.tgz",
    "ytrust": "https://github.com/VolRencs/ytrust/releases/download/v1.5.1/ytrust-1.5.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
