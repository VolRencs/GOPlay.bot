{
  "name": "goplaybot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts dev; } 2>&1 | tee -a data/logs/bot.log",
    "build": "next build",
    "start": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts start; } >> data/logs/bot.log 2>&1",
    "logs:rotate": "mkdir -p data/logs && find data/logs -maxdepth 1 -name bot.log -size +5M -exec mv {} {}.1 \\;",
    "migrate:auth": "node --env-file=.env scripts/migrate-auth.ts",
    "test": "node --test test/*.test.ts",
    "check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "2.6.2",
    "better-auth": "^1.7.14",
    "discord.js": "^14.27.0",
    "goemoji": "^0.3.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
