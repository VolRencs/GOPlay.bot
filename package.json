{
  "name": "goplaybot",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#db/*": "./src/db/*",
    "#components/*": "./src/components/*",
    "#contracts/*": "./src/contracts/*"
  },
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm logs:rotate && bash -o pipefail -c '{ pnpm migrate:auth && node scripts/run-both.ts dev; } 2>&1 | tee -a data/logs/bot.log'",
    "build": "next build",
    "start": "pnpm logs:rotate && { pnpm migrate:auth && node scripts/run-both.ts start; } >> data/logs/bot.log 2>&1",
    "logs:rotate": "mkdir -p data/logs && find data/logs -maxdepth 1 -name bot.log -size +5M -exec mv -f {} {}.1 \\;",
    "migrate:auth": "node --env-file=.env scripts/migrate-auth.ts",
    "test": "node --test test/*.test.ts",
    "check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-auth": "^1.7.22",
    "discord.js": "^14.28.1",
    "goemoji": "^0.3.1",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "welcome-render": "https://github.com/VolRencs/welcome-render/releases/download/v0.2.0/welcome-render-0.2.0.tgz",
    "ytrust": "https://github.com/VolRencs/ytrust/releases/download/v1.1.1/ytrust-1.1.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
